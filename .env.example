# LLM（兼容 OpenAI 协议的任意网关 / 内部模型服务）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Zoom Server-to-Server OAuth（拉取云录制 transcript）
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# 内部 Jira（Server / Data Center）
JIRA_DC=true
JIRA_URL=https://jira.internal.your-org.com
JIRA_USERNAME=scrum-bot
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=

# GitHub MCP + 发布目标仓库
GITHUB_TOKEN=
GITHUB_OWNER=your-org
GITHUB_REPO=scrum-dsu
GITHUB_BRANCH=main

# 流水线
PODS_CONFIG=config/pods.yaml
MCP_CONFIG=config/mcp.json
TIMEZONE=Asia/Shanghai
REQUIRE_HUMAN_APPROVAL=true
# 生成后直接提交，跳过人工确认（定时跑批时打开）
AUTO_COMMIT=false
